<?xml version="1.0" encoding="us-ascii"?>
<!-- MegIS workload for MQSim: 1 MEGIS_INIT, then 10 buckets of 1 MB, each sent as
     16 x 64 KB MEGIS_WRITE commands followed by 1 MEGIS_STEP(2) = 171 requests. -->
<MQSim_IO_Scenarios>
	<IO_Scenario>
		<IO_Flow_Parameter_Set_MegIS>
			<Priority_Class>HIGH</Priority_Class>
			<Device_Level_Data_Caching_Mode>WRITE_CACHE</Device_Level_Data_Caching_Mode>
			<Channel_IDs>0,1,2,3,4,5,6,7</Channel_IDs>
			<Chip_IDs>0,1,2,3</Chip_IDs>
			<Die_IDs>0,1</Die_IDs>
			<Plane_IDs>0,1</Plane_IDs>
			<Initial_Occupancy_Percentage>0</Initial_Occupancy_Percentage>
			<Stop_Time>0</Stop_Time>
			<Total_Requests_To_Generate>171</Total_Requests_To_Generate>
		</IO_Flow_Parameter_Set_MegIS>
	</IO_Scenario>
</MQSim_IO_Scenarios>
